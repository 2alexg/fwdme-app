{
  "name": "fwdme",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter app start",
    "web": "pnpm --filter app web",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "supabase test db",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript > packages/core/src/database.types.ts",
    "build:web": "pnpm --filter app build:web",
    "test:e2e": "docker run --rm --network host -u $(id -u):$(id -g) -e HOME=/tmp -v \"$PWD\":/repo -w /repo/e2e mcr.microsoft.com/playwright:v1.64.1-noble node smoke.mjs"
  }
}
