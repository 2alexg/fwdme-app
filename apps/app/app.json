{
  "expo": {
    "name": "Fwd:Me",
    "slug": "fwdme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fwdme.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14532D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.fwdme.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "text/plain"
            ]
          },
          "ios": {
            "enabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#14532D",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14532D"
          }
        }
      ]
    ],
    "scheme": "fwdme",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "fwdme4s-team",
    "extra": {
      "eas": {
        "projectId": "909d231a-c9b1-4123-b4f0-6f704585c50e"
      }
    }
  }
}
