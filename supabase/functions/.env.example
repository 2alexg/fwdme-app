# Local secrets for Edge Functions: cp supabase/functions/.env.example supabase/functions/.env
# Must match the `worker_secret` Vault entry from supabase/seed.sql.
WORKER_SECRET=local-dev-worker-secret
# Optional locally: without it items get page metadata only (no AI title/summary).
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5).
ENRICH_MODEL=
# Optional: Meta app token for Instagram/Facebook oEmbed.
META_OEMBED_TOKEN=
